# Скопируйте в .env и подставьте свои значения. .env в git не коммитится.

# Бот, от имени которого публикуется календарь.
# Токен берётся у @BotFather, бота нужно сделать администратором канала.
TELEGRAM_BOT_TOKEN=

# Канал или чат: @mychannel либо числовой id вида -1001234567890
TELEGRAM_CHAT_ID=

# --------------------------------------------------------------------------
# Transient Name Server: новые и сверхновые в AstroCalendar Live.
#
# Ключ бота бесплатный, но требует регистрации на https://www.wis-tns.org
# (Sign up → в профиле «Bots» создать бота). Нужны все три значения:
# api_key бота, его числовой id и имя.
#
# Без этих ключей остальные три источника ленты (покрытия, сближения NEO,
# новые кометы) работают как обычно — вкладка «Данные» просто покажет,
# что у TNS нет ключей.
TNS_API_KEY=
TNS_BOT_ID=
TNS_BOT_NAME=
